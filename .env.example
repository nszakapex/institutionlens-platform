# InstitutionLens Platform — environment variable names and descriptions only.
# Copy to `.env.local` for local development. Never commit secrets.

# --- Local demo (default until controlled cutover) ---
# Synthetic data only. No Supabase connection. Fail closed if demo vars are missing.
IL_APP_MODE=local-demo

# Explicit synthetic demo tenant id (server-only). Non-production.
IL_DEMO_TENANT_ID=demo-tenant-local

# Explicit synthetic demo principal id (server-only). Non-production.
IL_DEMO_PRINCIPAL_ID=demo-principal-local

# Optional: Node environment. Next.js also sets NODE_ENV during build/start.
# NODE_ENV=development

# --- Live modes (development | staging | production) ---
# Server-only publishable Supabase configuration. Required together — no partial config.
# Production-like modes NEVER fall back to synthetic demo data when config or gateway is absent.
# Do not set IL_DEMO_* together with IL_SUPABASE_* (mixed mode is rejected).
#
# IL_APP_MODE=development
# IL_APP_MODE=staging
# IL_APP_MODE=production
#
# IL_SUPABASE_URL=https://<20-character-project-ref>.supabase.co
# IL_SUPABASE_PROJECT_REF=<20-character-project-ref>
# IL_SUPABASE_PUBLISHABLE_KEY=<server-only-publishable-key>
# IL_REPOSITORY_REQUEST_TIMEOUT_MS=5000
# IL_REPOSITORY_MAX_PAGE_SIZE=50
#
# FORBIDDEN on user request paths (configuration loader rejects these):
# - NEXT_PUBLIC_SUPABASE* (no browser Supabase client)
# - IL_SUPABASE_SERVICE_ROLE_KEY, SUPABASE_SERVICE_ROLE_KEY
# - IL_SUPABASE_ANON_KEY, SUPABASE_ANON_KEY (use IL_SUPABASE_PUBLISHABLE_KEY server-side only)
# - IL_DATABASE_URL or any direct Postgres connection string
#
# Auth users and memberships are provisioned outside this repository.
# Remaining read RPC migration 20260715220000 must be applied externally before live cutover.
# Application rollback to demo: set IL_APP_MODE=local-demo and remove IL_SUPABASE_* vars.
# See docs/PHASE_9_BATCH_5_CUTOVER.md and docs/PHASE_9_BATCH_5_ROLLBACK.md.
